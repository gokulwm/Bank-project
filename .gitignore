# ==============================================================================
# Unified Bank Kiosk Project .gitignore
# ==============================================================================

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
.venv*/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.key
*.pem

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Node.js & Web Frontends
node_modules/
dist/
dist-ssr/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Runtime State
*.db
*.sqlite3
data/*.db
data/face_auth.db
qr_output/
ocr_output/
receipts_output/
run/
temp/
tmp/
*.log

# Model Weights & Binaries (dynamically loaded / local)
models/*.onnx
models/*.pth
models/*.bin
tesseract/
tesseract_bin/
Tesseract/

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
